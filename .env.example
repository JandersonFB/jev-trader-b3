# Ativo da B3 (sem sufixo .SA): PETR4, VALE3, ITUB4, BOVA11...
SYMBOL=PETR4
# Intervalo entre ticks do loop (cada tick = 1 decisão + 1 ordem simulada)
POLL_MS=2000

# Fonte de cotação: auto | brapi | yahoo. Sem BRAPI_TOKEN a brapi aceita poucas req/min;
# com token gratuito (brapi.dev) o limite sobe bastante.
QUOTE_PROVIDER=auto
BRAPI_TOKEN=

# Janela do pregão em America/Sao_Paulo. Fora dela:
#   CLOSED_MODE=walk → random walk ancorado no último fechamento real (dashboard segue vivo)
#   CLOSED_MODE=hold → repete a última cotação real, sem fills
MARKET_OPEN=10:00
MARKET_CLOSE=18:00
CLOSED_MODE=walk
WALK_STEP_BPS=6

# Livro sintético (a fonte gratuita não expõe o book real): spread total em bps do mid
SIM_SPREAD_BPS=8
QUOTE_INSIDE_TICKS=1

# Conta simulada em BRL (venda a descoberto permitida até o cap)
TRADE_SIZE_SHARES=100
MAX_POSITION_SHARES=500
BANKROLL_BRL=10000
SIM_FEES_BPS=1

# mock | jev — mock é um heurístico local; jev usa o modelo TypeSafe AI (precisa da key)
MODEL=mock
TYPESAFE_AI_API_KEY=
JEV_MODEL_ID=jev-latest

HORIZON_TICKS=15
PORT=3001
